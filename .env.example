# 이 파일을 복사해서 .env.local 로 이름을 바꾸고 키를 넣으면 내 컴퓨터에서 미리 볼 수 있어요.
# Vercel에서는 이 파일 대신 프로젝트 Settings → Environment Variables 에 같은 이름으로 넣어요.
# .env.local 은 GitHub에 올라가지 않게 막혀 있어요 (.gitignore).

# 카카오 개발자 콘솔 → 앱 → 플랫폼 키 → JavaScript 키
KAKAO_JS_KEY=

# 카카오 개발자 콘솔 → 앱 → 플랫폼 키 → REST API 키 (버스 경로용)
KAKAO_REST_KEY=

# GraphHopper 대시보드 → API Keys (걸어서·차 경로용)
GRAPHHOPPER_API_KEY=

# 공공데이터포털 마이페이지 → 일반 인증키 (Decoding)  ※ 없어도 사이트는 돌아가요
DATA_GO_KR_SERVICE_KEY=

# (선택) 관광지 집중률 예측 API 주소가 기본값과 다를 때만
# FORECAST_API_URL=https://apis.data.go.kr/B551011/TatsCnctrRateService/tatsCnctrRatedList

# 국가교통정보센터(ITS) 오픈데이터 → 인증키 (실시간 도로 속도·돌발상황용)  ※ 없어도 사이트는 돌아가요
ITS_API_KEY=

# ITS 중계 (네이버 클라우드 Cloud Functions, relay/ncp-its-relay.cjs)
#   ITS가 해외 회사 서버를 막아서 이 중계를 거쳐요. 주소는 API Gateway 호출 주소, 토큰은 함수 디폴트 파라미터의 token 과 같게.
ITS_RELAY_URL=
ITS_RELAY_TOKEN=
